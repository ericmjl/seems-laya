# Which Laya checkpoint answers judgments: english | multilingual | typed-decisions |
# router (auto-route per request) | a Hugging Face id such as convaiinnovations/laya.
# No API key: Laya is open-weight (Apache 2.0) and runs on your own hardware.
LAYA_MODEL=english

# Optional. Point this at a Laya server (docker compose starts one at http://laya:8000)
# and the app talks to it over HTTP; the app itself then needs only the standard library.
# Leave it unset and the `laya` package is imported in-process instead.
# LAYA_URL=http://laya:8000
